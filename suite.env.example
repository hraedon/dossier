# suite.env — shared suite configuration (Plan 014 WI-1.5 team deploy).
#
# Copy to `suite.env` and replace the placeholder values. `suite.env` is
# gitignored and MUST NEVER be committed — it carries the DSN, key path, and
# (optionally) the LDAP bind password for the whole suite.
#
# Precedence (blueprint §2.1): process env > suite.env > tool default.
# Anything set in the process environment overrides the value here.
#
# This file carries PLACEHOLDERS ONLY. No real work-domain identifier, host,
# account, or secret belongs here.

# ── Deployment posture (Plan 015 WI-1.1) ──────────────────────────────────
# dev (default) preserves the historical defaults (backwards compat). prod
# promotes safe defaults: require_ssl on, project_access_mode enforce (when
# an ACL is present), and the doctor escalates posture gaps (open access,
# missing TLS, missing session secret) from warn to fail. Set prod for every
# team deploy.
DOSSIER_ENV=prod

# TrustedHostMiddleware — only wired when set (dev unset = no middleware).
# Comma-separated allowed Host headers. In prod, pin this to the host(s) the
# team reaches dossier through (the TLS-terminating proxy or the app itself).
DOSSIER_ALLOWED_HOSTS=dossier.WORK-DOMAIN

# ── Suite-wide spine config (regista Plan 025 WI-1.1) ─────────────────────
# The canonical names shared across every suite component. The DOSSIER_*
# aliases still work but are deprecated — migrate by using these.
REGISTA_DSN=postgresql://dossier:replace-me@suite-db.example:5432/dossier
REGISTA_KEY_PATH=/run/secrets/dossier-keys.json
# Principal lifecycle events live in the explicitly configured estate-wide
# trust-log project. It must be a distinct schema from every work project.
REGISTA_TRUST_LOG_PROJECT=trust-log
REGISTA_TRUST_GENESIS_PATH=/run/secrets/trust-domain.json
# The trust-log project is a normal slug and the genesis value is a local
# readable path. Only REGISTA_DSN and REGISTA_KEY_PATH accept backend refs:
#   env:VAR_NAME          — resolved from the process env at startup
#   file:/path/to/secret   — read from a file at startup
#   vault:mount/path/key   — fetched from HashiCorp Vault (needs regista[vault])
#   azure:secret-name      — fetched from Azure Key Vault (needs regista[azure])
# v6 producer identity is process-level signed provenance, not request input.
# Harness and version are required. Set model + model lineage together for a
# model-backed producer; leave both unset for a non-model process.
REGISTA_PRODUCER_HARNESS=dossier
REGISTA_PRODUCER_HARNESS_VERSION=0.1.0
# REGISTA_PRODUCER_MODEL=MODEL-NAME
# REGISTA_PRODUCER_MODEL_LINEAGE=MODEL-LINEAGE
# A literal DSN / bare key path passes through unchanged (no backend contact).

# ── dossier project fronting ──────────────────────────────────────────────
DOSSIER_PROJECT=dossier                       # default regista project/schema
DOSSIER_PROJECTS=dossier                       # comma-separated list of projects to front

# ── Session + cookie security ─────────────────────────────────────────────
# May be an env:/file:/vault:/azure: ref; the resolved value must be >= 32 bytes.
DOSSIER_SESSION_SECRET=vault:mount/path/session-secret
DOSSIER_SECURE_COOKIES=true                    # false only for local dev without TLS

# ── Auth / identity source (blueprint §2.6) ───────────────────────────────
# local = JSON users file (dev/small teams); ldap = the workplace directory.
DOSSIER_AUTH_BACKEND=ldap
DOSSIER_USERS_PATH=/run/secrets/users.json     # used only when AUTH_BACKEND=local

# ── LDAP / Active Directory (the one-workplace identity source) ────────────
# All values are env-driven; the bind password is never committed — source it
# from the secret backend (env:/vault:/azure:) or set it in the process env.
DOSSIER_LDAP_SERVER=ldaps://dc1.WORK-DOMAIN:636,ldaps://dc2.WORK-DOMAIN:636
DOSSIER_LDAP_BASE_DN=DC=WORK-DOMAIN
DOSSIER_LDAP_BIND_DN=CN=svc-dossier,OU=Service Accounts,DC=WORK-DOMAIN
DOSSIER_LDAP_BIND_PASSWORD=env:DOSSIER_LDAP_BIND_PASSWORD
DOSSIER_LDAP_DOMAIN=WORK-DOMAIN
DOSSIER_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={login}))
DOSSIER_LDAP_GROUP_STRATEGY=direct
DOSSIER_LDAP_CA_CERT_FILE=/run/secrets/ldap/ad-root-ca.pem
DOSSIER_LDAP_CONNECT_TIMEOUT=5
# WI-035: the directory attribute carrying each human's suite regista
# principal_id, so their acceptance is signed with a key only they hold rather
# than the shared store key. Commonly sAMAccountName when logon names and
# principal ids match; a dedicated attribute when they do not. Unset means every
# LDAP identity is unbound — see DOSSIER_HUMAN_SIGNING below.
DOSSIER_LDAP_PRINCIPAL_ID_ATTR=sAMAccountName

# ── Human per-actor signing posture (WI-035) ──────────────────────────────
# require refuses any human write that could only be signed with the shared
# store HMAC key (the default in prod); warn records it but reports the
# downgrade in the log, the response, the UI, and the doctor. There is no
# silent mode. Provision each human with
# `agent-suite bootstrap --user <principal_id>` before setting require.
DOSSIER_HUMAN_SIGNING=require

# ── TLS termination (the team-deploy posture) ─────────────────────────────
# When both are set, uvicorn serves over TLS. When both unset, plain HTTP.
# Provision the cert+key on the host or mount them in the container deploy.
# In DOSSIER_ENV=prod, an unset TLS config is a doctor fail (the operator may
# instead put dossier behind a TLS-terminating proxy, but the seam must be
# evident — silent plaintext in prod is not acceptable).
DOSSIER_TLS_CERT_PATH=/run/secrets/tls/cert.pem
DOSSIER_TLS_KEY_PATH=/run/secrets/tls/key.pem
# Set true only when the ingress/proxy terminates TLS and the app serves HTTP
# behind it. This makes the deployment posture explicit in doctor output.
DOSSIER_BEHIND_TLS_PROXY=false

# ── Cross-project access control (Plan 015 WI-1.1; deny-by-default WI-017) ─
# enforce (THE DEFAULT) = default-deny policy loaded and enforced.
# audit = default-deny policy evaluated; denials logged but not enforced.
# open = every authenticated principal reads every project. Explicit opt-in
#        only; a doctor warn in dev and a fail in prod.
# enforce/audit with neither DOSSIER_PROJECT_ACL_PATH nor
# DOSSIER_BOOTSTRAP_ADMINS denies everything and is a doctor fail.
# See docs/project-access.md before upgrading a running instance.
DOSSIER_PROJECT_ACCESS_MODE=enforce
DOSSIER_PROJECT_ACL_PATH=/run/secrets/project-acl.json
# Recovery path: administrator principal IDs / name:|guid: group claims that
# work with no ACL file. Leave unset once the ACL names your administrators.
# DOSSIER_BOOTSTRAP_ADMINS=00000000-0000-0000-0000-000000000000
